[Unit]
Description=ExcaliDash Docker Compose stack
Requires=docker.service excalidash-secrets.service
After=docker.service excalidash-secrets.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/excalidash
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
